@model IEnumerable<BasicProject.Data.Entities.Quiz>

@{
    ViewData["Title"] = "Quizzes";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Quizzes</h2>
        <a class="btn btn-primary" href="@Url.Action("Create")">Create Quiz</a>
    </div>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Title</th>
                <th>Author</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var quiz in Model)
        {
            <tr>
                <td>@quiz.Id</td>
                <td>@quiz.Title</td>
                <td>@quiz.AuthorId</td>
                <td>
                    <a class="btn btn-sm btn-secondary" href="@Url.Action("Edit", new { id = quiz.Id })">Edit</a>
                    <a class="btn btn-sm btn-danger" href="@Url.Action("Delete", new { id = quiz.Id })">Delete</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

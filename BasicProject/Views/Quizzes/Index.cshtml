@model IEnumerable<BasicProject.Data.Entities.Quiz>

@{
    ViewData["Title"] = "Browse Quizzes";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2><i class="bi bi-collection"></i> Browse Quizzes</h2>
            <p class="text-muted">Select a quiz to test your knowledge</p>
        </div>
        <a class="btn btn-primary w-25" href="@Url.Action("Create", "QuizCreation")">
            <i class="bi bi-plus-circle"></i> Create New Quiz
        </a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> No quizzes available yet. <a href="@Url.Action("Create", "QuizCreation")">Create the first one!</a>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var quiz in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 shadow-sm quiz-card">
                        <div class="card-header bg-primary text-white">
                            <h5 class="card-title mb-0">@quiz.Title</h5>
                        </div>
                        <div class="card-body d-flex flex-column">
                            @if (!string.IsNullOrEmpty(quiz.Description))
                            {
                                <p class="card-text text-muted">@quiz.Description</p>
                            }
                            else
                            {
                                <p class="card-text text-muted fst-italic">No description available</p>
                            }
                            
                            <div class="mt-auto">
                                <hr />
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <small class="text-muted">
                                        <i class="bi bi-person"></i> @(quiz.Author?.Name ?? "Unknown")
                                    </small>
                                    <small class="text-muted">
                                        <i class="bi bi-question-circle"></i> @quiz.Questions.Count question@(quiz.Questions.Count != 1 ? "s" : "")
                                    </small>
                                </div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <small class="text-muted">
                                        <i class="bi bi-people"></i> @quiz.Attempts.Count attempt@(quiz.Attempts.Count != 1 ? "s" : "")
                                    </small>
                                    <small class="text-muted">
                                        <i class="bi bi-calendar"></i> @quiz.CreatedAt.ToString("MMM dd, yyyy")
                                    </small>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer bg-white border-top-0">
                            <a href="@Url.Action("Take", "QuizTaking", new { id = quiz.Id })" class="btn btn-success w-100">
                                <i class="bi bi-play-circle"></i> Take Quiz
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <style>
        .quiz-card {
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
        .quiz-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
        }
    </style>
}

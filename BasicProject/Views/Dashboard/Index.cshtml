@{
    ViewData["Title"] = "Project Quiz Dashboard";
}
<h1>Welcome, @ViewData["Username"]!</h1>
<p>You are now logged in</p>

<a class="cta-btn" asp-controller="Quizzes" asp-action="Create">
Create New Quiz
</a>

<p>Recent activity</p>
<ul>
    <li>Math - Score: 8/10</li>

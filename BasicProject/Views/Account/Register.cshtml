@{
    ViewData["Title"] = "Register";
}

<!--Kun basic, styler senere-->

<div class="text-center">
    <h1 class="display-4">Register</h1>
</div>

<div class="register-box">
    <h2>Create an account</h2>

    <form id="registerForm">
      <label for="username">Username</label>
      <input type="text" id="username" name="username" placeholder="F.eks.TheKnowledgeMaster" required minlength="3">

      <label for="email">E-mail</label>
      <input type="email" id="email" name="email" placeholder="your@email.com" required>

      <label for="password">Password</label>
      <input type="password" id="password" name="password" placeholder="At least 8 characters" required minlength="8">

      <label for="confirmPassword">Confirm password</label>
      <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Write your password again" required>

      <button type="submit" class="btn">Register</button>
      
    </form>

    <div class="footer">
      Already have an account?<a href="login.html">Log in here</a>
    </div>
  </div>
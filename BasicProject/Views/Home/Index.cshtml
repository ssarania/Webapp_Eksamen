@{
    ViewData["Title"] = "Project Quiz Home Page";
}
<div class="hero-section text-center">
    <h1 class="title">Welcome to Project Quiz</h1>
    <img src="~/images/ProjectQuiz-hero-quiz.png" alt="Project Quiz Banner" class="hero-image" /> <!-- Source: https://www.canva.com/design/DAG19w1R_3Y/e80vhbeTa_8PtX10KPXHsQ/edit -->
    <p class="hero-subtext">Learning is fun with Project Quiz!</p>
    <div class="cta-section">
        <a class="register-btn cta-btn bi-rocket-takeoff" asp-controller="Account" asp-action="Register">
        Get started
        </a>
        <a class="login-btn cta-btn" asp-controller="Account" asp-action="Login"> 
        I already have an account
        </a>
    </div>
</div>
<div class="about-section text-center">
    <div class="about">
    <!-- EXAMPLE TEXT -->
        <h2>About Project Quiz</h2>
        <p class="lead">Project Quiz is an interactive platform designed to make learning fun and engaging through quizzes. 
        Test your knowledge and create interactive lessons. Project Quiz has got you covered!</p>
        <p class="text-muted">Join us today and start your journey towards knowledge with Project Quiz!</p>
    </div>
    <div class="features">
        <h3>Features</h3>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card border-0 h-100">
                    <div class="card-body">
                        <i class="bi-journal-text fs-1 text-primary"></i>
                        <h5 class="card-title fw-semibold">Create & Take Quizzes</h5>
                        <p class="card-text text-muted">
                        Build and attempt quizzes across various subjects to test your knowledge.
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 h-100">
                    <div class="card-body">
                        <i class="bi-bar-chart-line fs-1 text-success"></i>
                        <h5 class="card-title fw-semibold">Track Your Progress</h5>
                        <p class="card-text text-muted">
                        Monitor your learning journey and measure performance over time.
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 h-100">
                    <div class="card-body">
                        <i class="bi-people fs-1 text-warning"></i>
                        <h5 class="card-title fw-semibold">Join the Community</h5>
                        <p class="card-text text-muted">
                        Engage with fellow learners and educators to share insights and ideas.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
